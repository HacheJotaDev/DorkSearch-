# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- Entorno / credenciales (NUNCA subir) ---
.env
.env.*
!.env.example

# --- Datos locales y bases de datos ---
data/
*.db
*.sqlite
*.sqlite3

# --- Proxies reales (usar solo como plantilla) ---
