# ============================================================
# CREDENCIALES — copia este archivo a ".env" y rellena los valores.
# NUNCA subas el .env real a un repositorio ni lo compartas.
# Las credenciales SIEMPRE se leen de variables de entorno.
# ============================================================

# Google Custom Search JSON API
# 1) https://console.cloud.google.com -> crea un proyecto -> habilita "Custom Search API"
# 2) Crea una CLAVE DE API y pégala aquí
GOOGLE_API_KEY=your_google_api_key_here

# 3) https://programmablesearchengine.google.com -> crea un motor -> copia el "Search engine ID"
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# (Opcional) Si prefieres el proveedor SerpAPI en lugar de Google CSE
SERPAPI_KEY=your_serpapi_key_here
